### Variables
@host = http://localhost:3002
@patientId = cmsnrdpl50001ilp4c03nq4wo
#################################################
# Patients
#################################################

### Get all patients
GET {{host}}/patients
Accept: application/json

###

### Get patient by id (itération 2)
GET {{host}}/patients/{{patientId}}
Accept: application/json

###

### Create patient (itération 2)
POST {{host}}/patients
Content-Type: application/json

{
  "firstName": "John",
  "lastName": "Doe"
}

###

### Update patient (itération 3)
PATCH {{host}}/patients/{{patientId}}
Content-Type: application/json

{
  "firstName": "Johnny"
}

###

### Delete patient (itération 3)
DELETE {{host}}/patients/{{patientId}}

###

### Health Check (si tu en ajoutes un)
GET {{host}}/
Accept: application/json

### Register
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "axel@test.com",
  "password": "password123",
  "firstName": "Axel",
  "lastName": "Coudair"
}

### Login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "axel@test.com",
  "password": "password123"
}

### Me
GET {{host}}/auth/me
Accept: application/json

#################################################
# Rendez-vous (cookie access_token requis : lancer Login avant)
#################################################

### Lister mes rendez-vous
GET {{host}}/appointments
Accept: application/json

### Lister à partir d'une date
GET {{host}}/appointments?from=2030-01-01T00:00:00Z
Accept: application/json

### Planifier (patientId = un patient existant, date dans le futur)
POST {{host}}/appointments
Content-Type: application/json

{
  "patientId": "{{patientId}}",
  "startsAt": "2030-01-01T09:00:00Z",
  "durationMinutes": 30
}

### Même créneau => 409 Conflict
POST {{host}}/appointments
Content-Type: application/json

{
  "patientId": "{{patientId}}",
  "startsAt": "2030-01-01T09:15:00Z",
  "durationMinutes": 30
}

### Durée hors limites => 422
POST {{host}}/appointments
Content-Type: application/json

{
  "patientId": "{{patientId}}",
  "startsAt": "2030-01-01T14:00:00Z",
  "durationMinutes": 300
}

### Annuler
@appointmentId = remplacer-par-un-id
PATCH {{host}}/appointments/{{appointmentId}}/cancel
